#include "resource.h"
#include <afxres.h>
#pragma code_page(65001)
LANGUAGE LANG_KOREAN, SUBLANG_DEFAULT
IDR_MAINFRAME ICON "res\\ipc2019.ico"
IDD_IPC2019_DIALOG DIALOGEX 0,0,650,385
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "ARP - Computer Network Practice"
FONT 9,"맑은 고딕",400,0,0x81
BEGIN
    GROUPBOX "ARP Cache",-1,10,8,315,231
    CONTROL "",IDC_CACHE,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,20,24,295,174
    PUSHBUTTON "Item Delete",IDC_DELETE,25,209,122,20
    PUSHBUTTON "All Delete",IDC_DELETE_ALL,182,209,122,20
    GROUPBOX "Proxy ARP Cache",-1,338,8,302,168
    CONTROL "",IDC_PROXY,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,348,22,282,70
    LTEXT "Device",-1,350,101,40,12
    COMBOBOX IDC_PROXY_DEVICE,395,99,235,150,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "IP 주소",-1,350,122,40,12
    EDITTEXT IDC_PROXY_IP,395,119,82,16,ES_AUTOHSCROLL
    LTEXT "MAC",-1,485,122,22,12
    EDITTEXT IDC_PROXY_MAC,510,119,120,16,ES_AUTOHSCROLL
    PUSHBUTTON "Add",IDC_PROXY_ADD,369,145,103,20
    PUSHBUTTON "Delete",IDC_PROXY_DELETE,506,145,103,20
    GROUPBOX "Gratuitous ARP",-1,338,183,302,56
    LTEXT "H/W 주소",-1,350,206,45,12
    EDITTEXT IDC_GARP_MAC,399,203,144,18,ES_AUTOHSCROLL
    PUSHBUTTON "Send",IDC_GARP_SEND,556,202,69,20,WS_DISABLED
    LTEXT "Target IP",-1,15,251,49,12
    EDITTEXT IDC_TARGET,69,248,164,18,ES_AUTOHSCROLL
    PUSHBUTTON "Send",IDC_SEND,244,247,70,20,WS_DISABLED
    LTEXT "GARP: 비우면 로컬 MAC / Proxy MAC: 응답에 사용할 H/W 주소",-1,349,251,285,14
    LTEXT "Adapter (IPv4)",-1,15,274,250,12
    LTEXT "Local MAC",-1,295,274,132,12
    LTEXT "Local IP",-1,436,274,112,12
    COMBOBOX IDC_ADAPTER,15,289,272,150,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_LOCAL_MAC,295,288,132,20,ES_READONLY | ES_AUTOHSCROLL
    EDITTEXT IDC_LOCAL_IP,436,288,112,20,ES_READONLY | ES_AUTOHSCROLL
    PUSHBUTTON "Select",IDC_SELECT,557,288,75,21
    PUSHBUTTON "Refresh",IDC_REFRESH,15,316,70,20
    LTEXT "",IDC_STATS,96,318,535,16
    LTEXT "",IDC_STATUS,15,345,619,32
END
