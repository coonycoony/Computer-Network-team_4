#include "resource.h"
#include <afxres.h>
#pragma code_page(65001)
LANGUAGE LANG_KOREAN, SUBLANG_DEFAULT
IDR_MAINFRAME ICON "res\\ipc2019.ico"
IDD_IPC2019_DIALOG DIALOGEX 0,0,560,384
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Router"
FONT 9,"맑은 고딕",400,0,0x81
BEGIN
    LTEXT "내부 Network",-1,12,15,48,10
    COMBOBOX IDC_ADAPTER0,62,12,150,150,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_MAC0,218,12,100,14,ES_CENTER | ES_READONLY | ES_AUTOHSCROLL
    CONTROL "",IDC_IP0,"SysIPAddress32",WS_TABSTOP,324,12,100,14
    LTEXT "외부 Network",-1,12,35,48,10
    COMBOBOX IDC_ADAPTER1,62,32,150,150,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_MAC1,218,32,100,14,ES_CENTER | ES_READONLY | ES_AUTOHSCROLL
    CONTROL "",IDC_IP1,"SysIPAddress32",WS_TABSTOP,324,32,100,14
    PUSHBUTTON "Start(&S)",IDC_START,432,10,56,36
    PUSHBUTTON "End(&E)",IDC_END,494,10,56,36,WS_DISABLED
    CTEXT "Static Routing Table",-1,10,58,310,10
    CONTROL "",IDC_ROUTES,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,10,70,310,262
    PUSHBUTTON "Add",IDC_ROUTE_ADD,90,338,52,18
    PUSHBUTTON "Delete",IDC_ROUTE_DELETE,168,338,52,18
    CTEXT "ARP Cache Table",-1,332,58,218,10
    CONTROL "",IDC_CACHE,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,332,70,218,90
    PUSHBUTTON "Delete",IDC_DELETE,414,166,54,18
    LTEXT "",IDC_STATS,332,190,218,44
    CTEXT "Proxy ARP Table",-1,332,240,218,10
    CONTROL "",IDC_PROXY,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,332,252,218,80
    PUSHBUTTON "Add",IDC_PROXY_ADD,380,338,52,18
    PUSHBUTTON "Delete",IDC_PROXY_DELETE,442,338,52,18
    LTEXT "",IDC_STATUS,10,362,540,18
END
IDD_ROUTE_ADD DIALOGEX 0,0,200,150
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Routing Table Entry 추가"
FONT 9,"맑은 고딕",400,0,0x81
BEGIN
    LTEXT "Destination",-1,14,17,50,10
    CONTROL "",IDC_ENTRY_DEST,"SysIPAddress32",WS_TABSTOP,70,14,116,14
    LTEXT "Netmask",-1,14,37,50,10
    CONTROL "",IDC_ENTRY_MASK,"SysIPAddress32",WS_TABSTOP,70,34,116,14
    LTEXT "Gateway",-1,14,57,50,10
    CONTROL "",IDC_ENTRY_GATEWAY,"SysIPAddress32",WS_TABSTOP,70,54,116,14
    LTEXT "Flag",-1,14,78,50,10
    AUTOCHECKBOX "UP",IDC_ENTRY_UP,70,77,30,12
    AUTOCHECKBOX "Gateway",IDC_ENTRY_GW,102,77,44,12
    AUTOCHECKBOX "Host",IDC_ENTRY_HOST,150,77,36,12
    LTEXT "Interface",-1,14,99,50,10
    COMBOBOX IDC_ENTRY_PORT,70,96,116,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "추가",IDOK,46,124,50,18
    PUSHBUTTON "취소",IDCANCEL,104,124,50,18
END
IDD_PROXY_ADD DIALOGEX 0,0,210,110
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Proxy Entry 추가"
FONT 9,"맑은 고딕",400,0,0x81
BEGIN
    LTEXT "Device",-1,14,17,58,10
    COMBOBOX IDC_ENTRY_DEVICE,78,14,118,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "IP Address",-1,14,37,58,10
    CONTROL "",IDC_ENTRY_IP,"SysIPAddress32",WS_TABSTOP,78,34,118,14
    LTEXT "Ethernet Address",-1,14,57,62,10
    EDITTEXT IDC_ENTRY_MAC,78,54,118,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON "추가",IDOK,50,84,50,18
    PUSHBUTTON "취소",IDCANCEL,110,84,50,18
END
